# ============================================================
#  VideoNote 配置文件
#  用法: 复制这个文件为 .env，然后填你自己的 key
#     copy .env.example .env
# ============================================================

# ---------- 1. 大模型 (摘要 / 笔记 / 翻译 / 画面理解) ----------
# 推荐 DeepSeek: https://platform.deepseek.com  -> API Keys -> 创建
# 怎么填: VN_LLM_API_KEY=sk-你的key
VN_LLM_PROVIDER=openai_compat
VN_LLM_BASE_URL=https://api.deepseek.com/v1
VN_LLM_API_KEY=
VN_LLM_MODEL=deepseek-chat
VN_LLM_TEMPERATURE=0.3
VN_LLM_MAX_TOKENS=4096

# 备用: 硅基流动也提供 OpenAI 兼容接口 (顺手可以填这个, 用于云端 ASR)
# VN_LLM_BASE_URL=https://api.siliconflow.cn/v1
# VN_LLM_MODEL=deepseek-ai/DeepSeek-V3

# ---------- 2. 语音识别 (ASR) ----------
# local  = 本机 faster-whisper (免费/离线/CPU 慢)
# cloud  = 云端 OpenAI 兼容接口 (快/准/要钱)     auto = 有云端 key 就用云端, 否则本地
VN_ASR_PROVIDER=local

# -- 本地 faster-whisper --
# tiny/base/small/medium/large-v3  (CPU 推荐 small 或 medium, 又快又够用)
VN_WHISPER_MODEL=small
VN_WHISPER_DEVICE=cpu
VN_WHISPER_COMPUTE_TYPE=int8          # CPU 用 int8 最快
VN_WHISPER_BEAM_SIZE=5
VN_WHISPER_VAD=true                   # 静音过滤, 能明显减少幻听
# 国内下载模型走镜像 (重要, 否则 huggingface.co 可能连不上)
VN_HF_ENDPOINT=https://hf-mirror.com
# 已经下好模型的话填本地目录, 例如 D:\models\faster-whisper-small
VN_WHISPER_MODEL_DIR=

# -- 云端 ASR --  硅基流动注册送额度, 填了就把上面 VN_ASR_PROVIDER 改成 cloud
VN_ASR_BASE_URL=https://api.siliconflow.cn/v1
VN_ASR_API_KEY=
VN_ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# ---------- 3. 说话人分离（谁在说话）----------
# local_ecapa = 本地声纹模型 + 聚类（免费/离线/CPU 可跑，第一次下载约 80MB）
# pyannote    = 更准，但模型是 gated 的，需要 HF token 并接受使用协议
VN_DIARIZE_PROVIDER=local_ecapa
VN_DIARIZE_NUM_SPEAKERS=0        # 0 = 自动判断人数；已知就填数字更准（比如美剧双人对话填 2）
# VN_HF_TOKEN=hf_xxx             # 只有用 pyannote 时才需要

# ---------- 4. 画面描述（视觉大模型，可选）----------
# 留空 = 只抽关键帧不做描述。填 vlm 就会把关键帧丢给视觉模型，把板书/PPT/演示写进笔记。
# 硅基流动有 Qwen2.5-VL 等，OpenAI 兼容接口；不填 VLM 的 key 就复用上面大模型的 key。
VN_VISION_PROVIDER=
VN_VLM_BASE_URL=https://api.siliconflow.cn/v1
VN_VLM_API_KEY=
VN_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VN_VLM_MAX_FRAMES=40             # 每条视频最多描述多少帧（按需付费，别设太大）

# ---------- 5. 服务 ----------
VN_HOST=127.0.0.1
VN_PORT=8756
VN_DATA_DIR=data
VN_FFMPEG=                     # 留空则自动使用 imageio-ffmpeg 自带的 ffmpeg

# ---------- 6. 功能开关 ----------
VN_ENABLE_OCR=false            # 画面硬字幕 OCR (需要另装 rapidocr-onnxruntime)
VN_YTDLP_COOKIES=              # 下载需要登录的站点时的 cookies.txt 路径

# ---- 音素级发音评测（告诉你「哪个音发错了」）----
# 需要先跑一次： .venv\Scripts\python.exe tools\get_phoneme_model.py  （1.2GB，只下一次）
VN_PHONEME_PROVIDER=auto         # auto = 装好依赖就开启；off = 只做词级评分
VN_PHONEME_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft
VN_PHONEME_MODEL_DIR=            # 留空 = data/models/wav2vec2-lv-60-espeak-cv-ft
VN_PHONEME_GOP_THRESHOLD=-1.2    # 判「发错了」的严格程度：越小越宽容（-1.0 严，-1.6 松）
VN_PHONEME_MAX_WORDS=8           # 每次最多精听几个可疑词（越多越慢）
VN_PHONEME_THREADS=8             # 音素模型的 CPU 线程数
VN_PHONEME_MIN_RMS=0.008         # 小于这个音量就认为「没录上」，不判你漏读

# ---- 远程访问（手机 / 外网自用）----
# 设了密码，服务才要求登录；留空或删掉 = 恢复「本机免登录」。
# 想通过隧道开公网访问，务必先设它 —— 否则 /api/fs/list 能把本机路径列给任何人。
# VN_PASSWORD=换成一个你自己的强密码
# VN_SECRET=可选；留空则从密码派生（改密码会让旧会话失效）
